# Apache Configuration for Vite React SPA Deployment
# این فایل برای دیپلوی روی هاست Apache آماده شده است
# بهینه شده برای LinkMarket - بازار خدمات سئو و برنامه‌نویسی حرفه‌ای

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.lancerha\.ir$ [NC]
  RewriteRule ^ https://lancerha.ir%{REQUEST_URI} [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ─── Legacy 301 Redirects ────────────────────────────────────────────────

  # Legacy Home URL → /
  RewriteRule ^bazar-lm[^/]+/linkmarket-main-[^/]+(/admin.*)?$ /$1 [R=301,L]

  # Legacy Category two-level URLs → single-level canonical
  RewriteRule ^link-sazi-seo/.+$ /link-sazi-seo [R=301,L]
  RewriteRule ^honar-va-tarahi-grafic/.+$ /honar-va-tarahi-grafic [R=301,L]
  RewriteRule ^seo-va-behineh-sazi-site/.+$ /seo-va-behineh-sazi-site [R=301,L]
  RewriteRule ^programming-web-app/.+$ /programming-web-app [R=301,L]
  RewriteRule ^dastiar-majazi-online/.+$ /dastiar-majazi-online [R=301,L]
  RewriteRule ^seo-mahali-google-maps/.+$ /seo-mahali-google-maps [R=301,L]
  RewriteRule ^mehman-nevisi-rportaj/.+$ /mehman-nevisi-rportaj [R=301,L]

  # Legacy Service URLs /khadamat-svcXXX/{slug} → /khadamat/{slug}
  RewriteRule ^khadamat-[^/]+/(.+)$ /khadamat/$1 [R=301,L]

  # Pagination page/1 → canonical (no /page/1)
  RewriteRule ^(.+)/page/1/?$ /$1 [R=301,L]

  # ─── SPA Fallback ────────────────────────────────────────────────────────

  # Handle React Router - redirect all non-file requests to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/favicon\.ico$
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
  RewriteCond %{REQUEST_URI} !^/site\.webmanifest$
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# Enable Compression (Gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching - Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  
  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  
  # HTML (no cache for HTML files)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
  # Cache static assets for 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  
  # Don't cache HTML files
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # Security Headers - هدرهای امنیتی
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  
  # Content Security Policy (CSP) - برای امنیت بیشتر
  # Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https: http: blob:; font-src 'self' data: https:; connect-src 'self' https: wss: ws:;"
  
  # Remove server signature - حذف اطلاعات سرور
  Header unset Server
  Header unset X-Powered-By
  Header unset X-AspNet-Version
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType application/javascript js
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddEncoding gzip svgz
</IfModule>

# Prevent directory listing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

# Force UTF-8 encoding for text files
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .xml .json .rss .atom
</IfModule>

# Error pages - صفحات خطا
# برای SPA، تمام خطاها به index.html هدایت می‌شوند
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
ErrorDocument 403 /index.html

# Rate Limiting - محدود کردن درخواست‌ها (اگر mod_evasive نصب است)
# <IfModule mod_evasive20.c>
#   DOSHashTableSize    2048
#   DOSPageCount        10
#   DOSSiteCount        50
#   DOSPageInterval     1
#   DOSSiteInterval     1
#   DOSBlockingPeriod   600
# </IfModule>

# Disable Server Signature - غیرفعال کردن امضای سرور
ServerSignature Off

# Hide Apache Version - مخفی کردن نسخه Apache
<IfModule mod_headers.c>
  Header unset Server
  Header unset X-Powered-By
</IfModule>

